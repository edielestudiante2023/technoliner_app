#--------------------------------------------------------------------
# Configuración de entorno — Technoliner
#
# Copia este archivo como `.env` y completa los valores.
# `.env` nunca se versiona (ver .gitignore).
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENTORNO
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://technoliner.local/'

#--------------------------------------------------------------------
# ENCRIPTACIÓN
#--------------------------------------------------------------------

# Generar con: php spark key:generate
encryption.key =

#--------------------------------------------------------------------
# BASE DE DATOS
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = technoliner_local
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# CORREO TRANSACCIONAL (Resend)
#--------------------------------------------------------------------

# La API key nunca se versiona. Se obtiene en https://resend.com
RESEND_API_KEY =
MAIL_FROM_EMAIL = 'notificaciones@correo.technoliner.co'
MAIL_FROM_NAME = 'Technoliner Web'
